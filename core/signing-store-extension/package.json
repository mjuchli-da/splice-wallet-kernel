{
    "name": "@canton-network/core-signing-store-extension",
    "version": "0.1.0",
    "type": "module",
    "description": "Browser extension storage implementation of the SigningDriverStore API using browser.storage.local",
    "license": "Apache-2.0",
    "author": "Marc Juchli <marc.juchli@digitalasset.com>",
    "packageManager": "yarn@4.9.4",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsup && tsc -p tsconfig.types.json",
        "dev": "tsup --watch --onSuccess \"tsc -p tsconfig.types.json\"",
        "flatpack": "yarn pack --out \"$FLATPACK_OUTDIR\"",
        "clean": "tsc -b --clean; rm -rf dist",
        "test": "yarn node --experimental-vm-modules $(yarn bin jest)"
    },
    "dependencies": {
        "@canton-network/core-signing-lib": "workspace:^"
    },
    "devDependencies": {
        "@jest/globals": "^30.2.0",
        "@swc/core": "^1.15.10",
        "@swc/jest": "^0.2.39",
        "@types/jest": "^30.0.0",
        "jest": "^30.2.0",
        "ts-jest": "^29.4.6",
        "ts-jest-resolver": "^2.0.1",
        "tsup": "^8.5.1",
        "typescript": "^5.9.3"
    },
    "files": [
        "dist/**"
    ],
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hyperledger-labs/splice-wallet-kernel.git",
        "directory": "core/signing-store-extension"
    }
}
